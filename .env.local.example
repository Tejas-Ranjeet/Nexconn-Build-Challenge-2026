# Nexconn API Credentials
# Get your App Key and App Secret from https://console.nexconn.ai/agile/apps/km
NEXT_PUBLIC_NEXCONN_APP_KEY=YOUR_APP_KEY
NEXCONN_APP_SECRET=YOUR_APP_SECRET

# Optional data center base URL (Default: Singapore https://api.sg-light-api.com)
# North America: https://api.us-light-api.com
# Saudi Arabia: https://api.sau-light-api.com
NEXCONN_BASE_URL=https://api.sg-light-api.com
